              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Regla de negocio correcta\", function () {",
              "    const datos = pm.response.json();",
              "    pm.expect(datos.prioritario).to.eql(true);",
              "    pm.expect(datos.recargo).to.eql(12000);",
