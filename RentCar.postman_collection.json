          "raw": "{\n    \"cliente\": \"Juan Perez\",\n    \"vehiculo\": \"Toyota Corolla\",\n    \"fecha\": \"2026-12-05\",\n    \"precioBase\": 150000,\n    \"prioritario\": true\n}",
